# INTEGRAL EMULATOR client connection settings
# Set login.server to the complete API base URL, including any path prefix.
login.server=
login.server_id=primary
login.remember=0
window.width=360
window.height=360
# Account-specific settings are edited by the Client after login.
# SETTINGS > OPTIONS controls gb.ir_off_delay_ticks (0..256, 8 MHz ticks; experimental)
# and sgb=enable/disable.
# SETTINGS > N64 KEYS CONFIG can configure controllers 1P-4P.
# Empty keys.n64_p2/p3/p4 values select AUTO.
# keys.n64_p2=
# keys.n64_p3=
# keys.n64_p4=
