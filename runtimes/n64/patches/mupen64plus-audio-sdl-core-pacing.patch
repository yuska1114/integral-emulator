+static size_t queued_output_samples(struct sdl_backend* sdl_backend, unsigned int* last_callback)
+{
+    size_t available;
+
+    SDL_LockAudio();
+    cbuff_tail(&sdl_backend->primary_buffer, &available);
+    if (last_callback != NULL)
+        *last_callback = sdl_backend->last_cb_time;
+    SDL_UnlockAudio();
+
+    return (size_t)(((int64_t)(available / N64_SAMPLE_BYTES) * sdl_backend->output_frequency * 100) /
+        (sdl_backend->input_frequency * sdl_backend->speed_factor));
+}
+
+int sdl_core_pacing(struct sdl_backend* sdl_backend, int enabled, int* correction_ppm)
+{
+    enum { MAX_CORRECTION_PPM = 10000 };
+    sdl_backend->core_pacing = enabled && sdl_backend->audio_sync && !sdl_backend->error;
+    if (sdl_backend->core_pacing && correction_ppm != NULL)
+    {
+        int64_t target = sdl_backend->target;
+        int64_t level = queued_output_samples(sdl_backend, NULL);
+        /* Correct clock drift gradually, with at most a 1% change in VI
+         * period. Queue errors of half the target use the full correction. */
+        int64_t correction = (level - target) * (2 * MAX_CORRECTION_PPM) / target;
+        if (correction > MAX_CORRECTION_PPM)
+            correction = MAX_CORRECTION_PPM;
+        if (correction < -MAX_CORRECTION_PPM)
+            correction = -MAX_CORRECTION_PPM;
+        *correction_ppm = (int) correction;
+    }
+    return sdl_backend->core_pacing;
+}
