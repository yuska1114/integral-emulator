 /* various helper functions for ram, rom, or MBC uses */
 
+static uint32_t read_le32(const uint8_t* data)
+{
+    return ((uint32_t)data[0]) |
+           ((uint32_t)data[1] << 8) |
+           ((uint32_t)data[2] << 16) |
+           ((uint32_t)data[3] << 24);
+}
+
+static uint64_t read_le64(const uint8_t* data)
+{
+    return ((uint64_t)read_le32(data)) |
+           ((uint64_t)read_le32(data + 4) << 32);
+}
+
+static void write_le32(uint8_t* data, uint32_t value)
+{
+    data[0] = (uint8_t)(value & 0xff);
+    data[1] = (uint8_t)((value >> 8) & 0xff);
+    data[2] = (uint8_t)((value >> 16) & 0xff);
+    data[3] = (uint8_t)((value >> 24) & 0xff);
+}
+
+static void write_le64(uint8_t* data, uint64_t value)
+{
+    write_le32(data, (uint32_t)(value & 0xffffffffu));
+    write_le32(data + 4, (uint32_t)(value >> 32));
+}
+
+static char* make_mbc3_rtc_filename(const char* ram_filename)
+{
+    size_t len;
+    char* rtc_filename;
+
+    if (ram_filename == NULL) {
+        return NULL;
+    }
+
+    len = strlen(ram_filename);
+    rtc_filename = (char*)malloc(len + 5);
+    if (rtc_filename == NULL) {
+        return NULL;
+    }
+
+    memcpy(rtc_filename, ram_filename, len);
+    memcpy(rtc_filename + len, ".rtc", 5);
+    return rtc_filename;
+}
+
+static int load_mbc3_rtc_sidecar(struct gb_cart* gb_cart)
+{
+    uint8_t data[48];
+    size_t read_count;
+    FILE* file;
+
+    if (gb_cart->rtc_filename == NULL) {
+        return -1;
+    }
+
+    file = fopen(gb_cart->rtc_filename, "rb");
+    if (file == NULL) {
+        return -1;
+    }
+
+    read_count = fread(data, 1, sizeof(data), file);
+    if (fclose(file) != 0 || read_count != sizeof(data)) {
+        return -1;
+    }
+
+    gb_cart->rtc.regs[MBC3_RTC_SECONDS] = (uint8_t)read_le32(data + 0);
+    gb_cart->rtc.regs[MBC3_RTC_MINUTES] = (uint8_t)read_le32(data + 4);
+    gb_cart->rtc.regs[MBC3_RTC_HOURS] = (uint8_t)read_le32(data + 8);
+    gb_cart->rtc.regs[MBC3_RTC_DAYS_L] = (uint8_t)read_le32(data + 12);
+    gb_cart->rtc.regs[MBC3_RTC_DAYS_H] = (uint8_t)read_le32(data + 16);
+
+    gb_cart->rtc.latched_regs[MBC3_RTC_SECONDS] = (uint8_t)read_le32(data + 20);
+    gb_cart->rtc.latched_regs[MBC3_RTC_MINUTES] = (uint8_t)read_le32(data + 24);
+    gb_cart->rtc.latched_regs[MBC3_RTC_HOURS] = (uint8_t)read_le32(data + 28);
+    gb_cart->rtc.latched_regs[MBC3_RTC_DAYS_L] = (uint8_t)read_le32(data + 32);
+    gb_cart->rtc.latched_regs[MBC3_RTC_DAYS_H] = (uint8_t)read_le32(data + 36);
+
+    gb_cart->rtc.latch = 0;
+    gb_cart->rtc.last_time = (time_t)read_le64(data + 40);
+    gb_cart->rtc.loaded = 1;
+
+    DebugMessage(M64MSG_INFO, "GB Loader RTC: %s - %zu",
+            gb_cart->rtc_filename,
+            sizeof(data));
+    return 0;
+}
+
+static void save_mbc3_rtc_sidecar(struct gb_cart* gb_cart)
+{
+    uint8_t data[48];
+    FILE* file;
+
+    if (gb_cart->rtc_filename == NULL) {
+        return;
+    }
+
+    write_le32(data + 0, gb_cart->rtc.regs[MBC3_RTC_SECONDS]);
+    write_le32(data + 4, gb_cart->rtc.regs[MBC3_RTC_MINUTES]);
+    write_le32(data + 8, gb_cart->rtc.regs[MBC3_RTC_HOURS]);
+    write_le32(data + 12, gb_cart->rtc.regs[MBC3_RTC_DAYS_L]);
+    write_le32(data + 16, gb_cart->rtc.regs[MBC3_RTC_DAYS_H]);
+
+    write_le32(data + 20, gb_cart->rtc.latched_regs[MBC3_RTC_SECONDS]);
+    write_le32(data + 24, gb_cart->rtc.latched_regs[MBC3_RTC_MINUTES]);
+    write_le32(data + 28, gb_cart->rtc.latched_regs[MBC3_RTC_HOURS]);
+    write_le32(data + 32, gb_cart->rtc.latched_regs[MBC3_RTC_DAYS_L]);
+    write_le32(data + 36, gb_cart->rtc.latched_regs[MBC3_RTC_DAYS_H]);
+
+    write_le64(data + 40, (uint64_t)gb_cart->rtc.last_time);
+
+    file = fopen(gb_cart->rtc_filename, "wb");
+    if (file == NULL) {
+        DebugMessage(M64MSG_WARNING, "couldn't open GB RTC file '%s' for writing",
+                gb_cart->rtc_filename);
+        return;
+    }
+
+    if (fwrite(data, 1, sizeof(data), file) != sizeof(data)) {
+        DebugMessage(M64MSG_WARNING, "failed to write GB RTC file '%s'",
+                gb_cart->rtc_filename);
+    }
+
+    fclose(file);
+}
