+typedef int (*integral_n64_runtime_remote_state_fn)(uint64_t *buttons);
+
+static integral_n64_runtime_remote_state_fn find_remote_state(void)
+{
+    static integral_n64_runtime_remote_state_fn function;
+    static int attempted;
+    if (!attempted) {
+#if defined(_WIN32)
+        function = (integral_n64_runtime_remote_state_fn)(void *)GetProcAddress(
+            GetModuleHandle(NULL), "integral_n64_runtime_remote_controller_state");
+#else
+        *(void **)(&function) = dlsym(
+            RTLD_DEFAULT, "integral_n64_runtime_remote_controller_state");
+#endif
+        attempted = 1;
+    }
+    return function;
+}
+
+static BUTTONS remote_controller_state(uint64_t buttons)
+{
+    BUTTONS keys;
+    memset(&keys, 0, sizeof(keys));
+    if ((buttons & (1ULL << 0)) != 0U) {
+        keys.R_DPAD = 1U;
+    }
+    if ((buttons & (1ULL << 1)) != 0U) {
+        keys.L_DPAD = 1U;
+    }
+    if ((buttons & (1ULL << 2)) != 0U) {
+        keys.U_DPAD = 1U;
+    }
+    if ((buttons & (1ULL << 3)) != 0U) {
+        keys.D_DPAD = 1U;
+    }
+    if ((buttons & (1ULL << 4)) != 0U) keys.A_BUTTON = 1U;
+    if ((buttons & (1ULL << 5)) != 0U) keys.B_BUTTON = 1U;
+    if ((buttons & (1ULL << 6)) != 0U) keys.START_BUTTON = 1U;
+    if ((buttons & (1ULL << 7)) != 0U) keys.Z_TRIG = 1U;
+    if ((buttons & (1ULL << 8)) != 0U) keys.L_TRIG = 1U;
+    if ((buttons & (1ULL << 9)) != 0U) keys.R_TRIG = 1U;
+    if ((buttons & (1ULL << 10)) != 0U) keys.R_CBUTTON = 1U;
+    if ((buttons & (1ULL << 11)) != 0U) keys.L_CBUTTON = 1U;
+    if ((buttons & (1ULL << 12)) != 0U) keys.U_CBUTTON = 1U;
+    if ((buttons & (1ULL << 13)) != 0U) keys.D_CBUTTON = 1U;
+    if ((buttons & (1ULL << 14)) != 0U) keys.X_AXIS = 80;
+    if ((buttons & (1ULL << 15)) != 0U) keys.X_AXIS = -80;
+    if ((buttons & (1ULL << 16)) != 0U) keys.Y_AXIS = 80;
+    if ((buttons & (1ULL << 17)) != 0U) keys.Y_AXIS = -80;
+    return keys;
+}
