+
+static void rewind_mbc3_rtc_seconds(GB_gameboy_t *gb, uint64_t seconds)
+{
+    while (seconds--) {
+        if (gb->rtc_real.seconds-- != 0) continue;
+        gb->rtc_real.seconds = 59;
+        if (gb->rtc_real.minutes-- != 0) continue;
+        gb->rtc_real.minutes = 59;
+        if (gb->rtc_real.hours-- != 0) continue;
+        gb->rtc_real.hours = 23;
+        if (gb->rtc_real.days-- != 0) continue;
+        gb->rtc_real.days = 0xFF;
+        gb->rtc_real.high ^= 1;
+    }
+}
+
+static void rewind_huc3_rtc_seconds(GB_gameboy_t *gb, uint64_t seconds)
+{
+    uint64_t minutes = seconds / 60;
+    while (minutes--) {
+        if (gb->huc3.minutes-- != 0) continue;
+        gb->huc3.minutes = 60 * 24 - 1;
+        if (gb->huc3.days != 0) {
+            gb->huc3.days--;
+        }
+    }
+}
+
+int GB_apply_rtc_offset(GB_gameboy_t *gb, int64_t offset_seconds)
+{
+    GB_ASSERT_NOT_RUNNING_OTHER_THREAD(gb)
+
+    if (!gb->cartridge_type ||
+        (gb->cartridge_type->mbc_type != GB_HUC3 && !gb->cartridge_type->has_rtc) ||
+        offset_seconds == 0) {
+        return 0;
+    }
+
+    uint64_t now = (uint64_t)time(NULL);
+    if (offset_seconds > 0) {
+        GB_rtc_set_time(gb, gb->last_rtc_second + (uint64_t)offset_seconds);
+    }
+    else if (gb->cartridge_type->mbc_type == GB_HUC3) {
+        uint64_t seconds = (uint64_t)-offset_seconds;
+        rewind_huc3_rtc_seconds(gb, seconds);
+    }
+    else {
+        uint64_t seconds = (uint64_t)-offset_seconds;
+        rewind_mbc3_rtc_seconds(gb, seconds);
+    }
+    gb->last_rtc_second = now;
+    return 1;
 }
 
