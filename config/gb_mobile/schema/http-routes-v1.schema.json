{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "initial_state", "routes"],
  "properties": {
    "schema_version": {"const": 1},
    "initial_state": {"type": "object", "maxProperties": 64, "additionalProperties": {"type": "boolean"}},
    "routes": {"type": "array", "maxItems": 256, "items": {"type": "object"}}
  }
}
