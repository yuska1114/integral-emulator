{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integral-emulator.invalid/schema/gb-mobile/package-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "display_name", "adapter_id", "rom_titles", "active_release_id", "status", "provenance_path", "license_paths"],
  "properties": {
    "schema_version": {"const": 2},
    "package_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 128},
    "adapter_id": {"const": "gb_mobile_v2"},
    "rom_titles": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 20}},
    "active_release_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "status": {"enum": ["candidate", "approved", "disabled"]},
    "provenance_path": {"type": "string", "minLength": 1},
    "license_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
