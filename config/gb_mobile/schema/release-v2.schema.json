{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://integral-emulator.invalid/schema/gb-mobile/release-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "created_at", "approved_by", "approved_at", "package_digest", "runtime_capability_version", "route_schema_version", "limits", "artifacts", "materializers", "rollback_release_id"],
  "properties": {
    "schema_version": {"const": 2},
    "release_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "created_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "approved_by": {"type": "string", "minLength": 1, "maxLength": 128},
    "approved_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "package_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_capability_version": {"enum": [2, 3]},
    "route_schema_version": {"enum": [1, 2]},
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["max_request_body", "max_sink_body", "max_connections"],
      "properties": {
        "max_request_body": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "max_sink_body": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "max_connections": {"type": "integer", "minimum": 1, "maximum": 32}
      }
    },
    "artifacts": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "content_id", "path", "size", "sha256"],
        "properties": {
          "role": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
          "content_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
          "path": {"type": "string", "minLength": 1},
          "size": {"type": "integer", "minimum": 0, "maximum": 16777216},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "materializers": {
      "type": "array", "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "source_content_id", "target_role", "target_content_id", "item_size"],
        "properties": {
          "type": {"const": "random_fixed_slice"},
          "source_content_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
          "target_role": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
          "target_content_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
          "item_size": {"type": "integer", "minimum": 1, "maximum": 4096}
        }
      }
    },
    "rollback_release_id": {"type": ["string", "null"]}
  }
}
