{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "routes"],
  "properties": {
    "schema_version": {"const": 1},
    "routes": {"type": "array", "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["name", "endpoint"], "properties": {"name": {"type": "string"}, "endpoint": {"const": "mobile-gateway"}}}}
  }
}
